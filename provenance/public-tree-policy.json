{
  "schemaVersion": 1,
  "allowedPaths": [
    ".gitignore",
    ".node-version",
    ".npmrc",
    "CONTRIBUTING.md",
    "COPYRIGHT.md",
    "LICENSE",
    "PLAN.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "TRADEMARKS.md",
    "biome.json",
    "content/learn/**",
    "package.json",
    "playwright.config.ts",
    "pnpm-lock.yaml",
    "provenance/**",
    "scripts/**",
    "src/**",
    "static/**",
    "svelte.config.js",
    "tests/**",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "deniedPaths": [
    "**/.env*",
    "**/*.key",
    "**/*.p12",
    "**/*.pem",
    "**/id_rsa*",
    "deploy/**",
    "deployment/**",
    "src/hooks.server.*",
    "src/lib/api.*",
    "src/routes/api/**",
    "src/routes/investigations/**",
    "src/routes/reports/**"
  ]
}
