{
  "name": "@link42-au/link42",
  "version": "0.0.0",
  "private": true,
  "description": "The public Link42 website",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "generate:content": "node scripts/generate-content.ts",
    "check": "pnpm generate:content --check && pnpm check:manifest && pnpm check:receipts && pnpm check:imports && pnpm check:public && pnpm check:format && pnpm check:types",
    "check:gitleaks": "node scripts/check-gitleaks.mjs",
    "check:imports": "node scripts/check-import-receipts.mjs",
    "check:manifest": "node scripts/check-source-manifest.mjs",
    "check:receipts": "node scripts/check-source-receipts.mjs",
    "check:public": "node scripts/check-public-safety.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:format": "biome check .",
    "check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm check:gitleaks && pnpm test && pnpm build && pnpm check:routes && pnpm test:e2e && pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "marked": "18.0.11",
    "svelte": "5.56.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.20.1",
    "svelte-check": "4.5.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
