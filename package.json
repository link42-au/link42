{
  "name": "@link42-au/link42",
  "version": "0.0.0",
  "private": true,
  "description": "The public Link42 website",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "check": "pnpm check:manifest && pnpm check:public",
    "check:manifest": "node scripts/check-source-manifest.mjs",
    "check:public": "node scripts/check-public-safety.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm check && pnpm test"
  }
}
